{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "answer_values": {
      "const": {
        "yes": 1,
        "no": 0,
        "maybe": 0.33
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "evaluator": {
            "enum": [
              "deterministic",
              "llm"
            ]
          },
          "check": {
            "type": "string"
          },
          "anchors": {
            "type": "object",
            "properties": {
              "yes": {
                "type": "string",
                "minLength": 1
              },
              "maybe": {
                "type": "string",
                "minLength": 1
              },
              "no": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "yes",
              "maybe",
              "no"
            ],
            "additionalProperties": false
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "question",
          "weight",
          "evaluator",
          "check",
          "anchors",
          "required_evidence"
        ],
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      }
    }
  },
  "required": [
    "id",
    "version",
    "answer_values",
    "criteria"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
