              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Webhook').item.json.body.environment.access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"operation\": \"tests.run\",\n  \"arguments\": {}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1136,
        0
      ],
      "id": "a3577714-6946-425d-ac37-65913d9339ab",
      "name": "Run Tests"
    },
    {
      "parameters": {
        "method": "POST",
        "url": " http://127.0.0.1:5001/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  \"prompt\": `Write a concise production incident summary based ONLY on the evidence below.\n\nINCIDENT:\n${JSON.stringify($('Read Incident').item.json.value, null, 2)}\n\nORIGINAL SOURCE:\n${$('Read Source').item.json.value.content}\n\nDIAGNOSIS:\n${$('Investigate Incident').item.json.output}\n\nPATCH RESULT:\n${JSON.stringify($('Apply Patch').item.json, null, 2)}\n\nTEST RESULT:\n${JSON.stringify($('Run Tests').item.json, null, 2)}\n\nReturn ONLY Markdown with these headings:\n\n# Incident Summary\n## Impact\n## Root Cause\n## Resolution\n## Verification\n\nRequirements:\n- Be factual and concise.\n- State what failed.\n- Explain the diagnosed root cause.\n- Describe the actual patch that was applied.\n- Report the test result accurately.\n- Do not invent evidence.\n- Do not include Markdown code fences.`,\n  \"mode\": \"read\"\n}\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1360,
        0
      ],
      "id": "7d4a1c6a-3578-4b78-a02d-07726f442d69",
      "name": "Generate Incident Summary"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://127.0.0.1:9301/runs/' + $('Webhook').item.json.body.execution_id + '/complete' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  \"submission\": {\n    \"protocol_version\": \"1.0\",\n    \"run_id\": $('Webhook').item.json.body.run_id,\n    \"status\": \"completed\",\n    \"final_answer\": \"The checkout incident was diagnosed, patched, and verified. See incident-summary.md for details.\",\n    \"artifacts\": [\n      {\n        \"name\": \"incident-summary.md\",\n        \"media_type\": \"text/markdown\",\n        \"content\": $('Generate Incident Summary').item.json.output\n      }\n    ],\n    \"trace\": [\n      {\n        \"timestamp\": new Date().toISOString(),\n        \"kind\": \"diagnosis\",\n        \"data\": {\n          \"result\": $('Investigate Incident').item.json.output\n        }\n      },\n      {\n        \"timestamp\": new Date().toISOString(),\n        \"kind\": \"patch\",\n        \"data\": {\n          \"result\": $('Apply Patch').item.json\n        }\n      },\n      {\n        \"timestamp\": new Date().toISOString(),\n        \"kind\": \"tests\",\n        \"data\": {\n          \"result\": $('Run Tests').item.json\n        }\n      }\n    ]\n  }\n}\n}}",
        "options": {}
      },
