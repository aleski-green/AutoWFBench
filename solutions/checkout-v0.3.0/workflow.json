              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  \"operation\": \"checkout.patch\",\n  \"arguments\": {\n    \"old\": JSON.parse($('Investigate Incident').item.json.output).old,\n    \"new\": JSON.parse($('Investigate Incident').item.json.output).new\n  }\n}\n}}",
        "options": {}
      },
