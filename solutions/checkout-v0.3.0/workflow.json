        "url": "={{ 'http://127.0.0.1:9303/runs/' + $('Webhook').item.json.body.execution_id + '/complete' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  \"submission\": {\n    \"protocol_version\": \"1.0\",\n    \"run_id\": $('Webhook').item.json.body.run_id,\n    \"status\": \"completed\",\n    \"final_answer\": \"The EUR checkout failure was caused by reversed arguments in the payment call. The workflow applied a minimal patch to restore the correct amount/currency argument order. Pre-repair tests reproduced the EUR failure, and post-repair tests passed for EUR checkout, USD checkout, and invalid-payment rejection.\",\n    \"artifacts\": [\n      {\n        \"name\": \"incident-summary.md\",\n        \"media_type\": \"text/markdown\",\n        \"content\": $('Build Incident Summary').item.json.output\n      }\n    ],\n    \"trace\": [\n      {\n        \"timestamp\": new Date().toISOString(),\n        \"kind\": \"pre_repair_tests\",\n        \"data\": {\n          \"result\": $('Run Tests Before').item.json\n        }\n      },\n      {\n        \"timestamp\": new Date().toISOString(),\n        \"kind\": \"diagnosis\",\n        \"data\": {\n          \"result\": $('Investigate Incident').item.json.output\n        }\n      },\n      {\n        \"timestamp\": new Date().toISOString(),\n        \"kind\": \"patch\",\n        \"data\": {\n          \"result\": $('Apply Patch').item.json\n        }\n      },\n      {\n        \"timestamp\": new Date().toISOString(),\n        \"kind\": \"post_repair_tests\",\n        \"data\": {\n          \"result\": $('Run Tests After').item.json\n        }\n      }\n    ]\n  }\n}\n}}",
        "options": {}
